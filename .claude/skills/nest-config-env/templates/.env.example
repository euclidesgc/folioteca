# Ambiente de execução. development | test | production.
NODE_ENV=development

# Porta HTTP da aplicação.
PORT=3000

# Postgres da aplicação.
# Local: sobe com `docker compose up db` neste repositório.
# Homologação e produção: cofre do ambiente, chave `database/app-url`.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Segredo de assinatura do JWT, mínimo de 32 caracteres.
# Gere um valor local com: openssl rand -base64 48
# Em homologação e produção vem do cofre, chave `auth/jwt-secret`.
JWT_SECRET=

# Tempo de vida do access token, no formato aceito pelo `jsonwebtoken`.
JWT_EXPIRES_IN=15m

# Origens permitidas no CORS, separadas por vírgula.
# Vazio libera apenas localhost.
CORS_ORIGINS=

# Nível mínimo do log estruturado. debug | info | warn | error.
LOG_LEVEL=info
