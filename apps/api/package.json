{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.js --runInBand",
    "openapi:generate": "ts-node --transpile-only scripts/generate-openapi.ts",
    "e2e:seed-member": "ts-node --transpile-only scripts/seed-e2e-member.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@blocknote/code-block": "^0.54.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/server-util": "^0.54.0",
    "@hocuspocus/extension-database": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "crossws": "^0.4.12",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "joi": "18.2.5",
    "nodemailer": "9.1.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@jest/test-sequencer": "30.4.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "ws": "^8.21.3"
  }
}
