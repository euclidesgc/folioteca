datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A organização é única na instância: `singleton` só aceita `true` e é único.
model Organization {
  id        String   @id @default(uuid())
  name      String
  singleton Boolean  @unique @default(true)
  createdAt DateTime @default(now())

  orgUnits OrgUnit[]
  people   Person[]
}

/// Unidade organizacional; a raiz tem `parentId` nulo.
model OrgUnit {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       OrgUnit?     @relation("OrgUnitToParent", fields: [parentId], references: [id])
  children     OrgUnit[]    @relation("OrgUnitToParent")
  space        Space?

  @@index([parentId])
}

model Person {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  space        Space?
  sessions     Session[]
}

enum SpaceType {
  PERSONAL
  UNIT
  FREE
}

/// Espaço de documentos: pessoal, de unidade ou livre.
model Space {
  id        String    @id @default(uuid())
  type      SpaceType
  personId  String?   @unique
  orgUnitId String?   @unique
  createdAt DateTime  @default(now())

  person  Person?  @relation(fields: [personId], references: [id])
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])
}

/// Sessão opaca: só o sha256 do token é guardado.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  personId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}
