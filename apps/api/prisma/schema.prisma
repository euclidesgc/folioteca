datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A organização é única na instância: `singleton` só aceita `true` e é único.
model Organization {
  id        String   @id @default(uuid())
  name      String
  singleton Boolean  @unique @default(true)
  createdAt DateTime @default(now())

  orgUnits    OrgUnit[]
  people      Person[]
  invitations Invitation[]
  spaces      Space[]
}

/// Unidade organizacional; a raiz tem `parentId` nulo.
///
/// Two unique indexes guard this table and Prisma cannot express either of
/// them, so they live only in the handwritten migration `0007`:
/// `OrgUnit_single_root_key` keeps a single root per database (partial index
/// over `("parentId" IS NULL)`), and `OrgUnit_parentId_lower_name_key` keeps
/// sibling names unique regardless of letter case (expression index over
/// `lower("name")`). Because they are invisible to this schema, `migrate
/// diff` would report a false "drift" and must never be run here.
model OrgUnit {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  parent       OrgUnit?            @relation("OrgUnitToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children     OrgUnit[]           @relation("OrgUnitToParent")
  space        Space?
  assignments  OrgUnitAssignment[]

  @@index([parentId])
}

/// Lotação: a pessoa está lotada na unidade. Uma pessoa pode estar lotada em
/// várias unidades, e a chave primária composta é a única garantia de que ela
/// não se lota duas vezes na mesma — não há consulta prévia de duplicidade em
/// lugar nenhum, o 409 nasce do índice. A lotação direta dá acesso de edição
/// aos documentos do espaço da unidade, decidido só pela porta
/// `AccessService`; a herança entre unidades não dá acesso a documento.
model OrgUnitAssignment {
  orgUnitId String
  personId  String
  createdAt DateTime @default(now())

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([orgUnitId, personId])
  @@index([personId])
}

model Person {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization      Organization        @relation(fields: [organizationId], references: [id])
  space             Space?              @relation("PersonalSpace")
  ownedSpaces       Space[]             @relation("SpaceOwner")
  sessions          Session[]
  authoredDocuments Document[]          @relation("DocumentAuthor")
  ownedDocuments    Document[]          @relation("DocumentOwner")
  favorites         Favorite[]
  sentInvitations   Invitation[]        @relation("InvitationInviter")
  assignments       OrgUnitAssignment[]
  documentShares    DocumentShare[]
}

enum SpaceType {
  PERSONAL
  UNIT
  FREE
}

/// Espaço de documentos: pessoal, de unidade ou livre.
///
/// The type/owner check constraint (`Space_type_owner_check`: which columns
/// each type requires or forbids) cannot be expressed by Prisma, so it lives
/// only in the handwritten migrations `0002` and `0013`.
model Space {
  id             String    @id @default(uuid())
  type           SpaceType
  personId       String?   @unique
  orgUnitId      String?   @unique
  organizationId String?
  name           String?
  ownerId        String?
  /// `true` faz quem vê o espaço da unidade-pai ver também este. A restrição
  /// "só espaço UNIT herda" vive só na migration 0014 (o Prisma não a expressa).
  inheritsParent Boolean   @default(false)
  createdAt      DateTime  @default(now())

  person       Person?       @relation("PersonalSpace", fields: [personId], references: [id])
  orgUnit      OrgUnit?      @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        Person?       @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@index([ownerId])
}

/// Documento de um espaço: quem escreveu (`authorId`) e quem é dono (`ownerId`).
/// `trashedAt` nulo significa fora da lixeira. Consequência aceita: mover para
/// a lixeira e restaurar avançam o `updatedAt`, porque ele é `@updatedAt`.
model Document {
  id        String    @id @default(uuid())
  title     String
  spaceId   String
  authorId  String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trashedAt DateTime?

  content   DocumentContent?
  favorites Favorite[]
  shares    DocumentShare[]
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  author    Person           @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  owner     Person           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, trashedAt(sort: Desc)])
  @@index([spaceId])
}

/// Marcação pessoal de documento. Não dá acesso: só marca o que já é legível.
model Favorite {
  personId   String
  documentId String
  createdAt  DateTime @default(now())

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([personId, documentId])
  @@index([personId, createdAt(sort: Desc)])
  @@index([documentId])
}

/// Nível de um compartilhamento direto. `EDIT` fica reservado para a fatia 148.
enum ShareLevel {
  VIEW
  EDIT
}

/// Compartilhamento direto de um documento com uma pessoa da instância.
model DocumentShare {
  documentId String
  personId   String
  level      ShareLevel
  createdAt  DateTime   @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([documentId, personId])
  @@index([personId])
}

/// Estado Yjs consolidado do documento, fora do modelo lido pelas listas.
model DocumentContent {
  documentId String   @id
  state      Bytes
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

/// Convite pendente para entrar na organização. Só o sha256 do token é
/// guardado, como em `Session`: o link em claro existe uma única vez, na
/// resposta da criação.
///
/// `acceptedAt` nulo é convite pendente; preenchido é convite já usado, que a
/// linha guarda como auditoria de quem entrou por convite. `revokedAt` segue a
/// mesma ideia: a administração corta o convite marcando a data, e a linha
/// nunca é apagada, para continuar respondendo "este link foi revogado quando".
///
/// Um índice único por expressão (`lower("email")`) garante "um convite
/// pendente por e-mail" e o Prisma não sabe expressá-lo: ele vive só nas
/// migrations `0009`, `0010` e `0011` escritas à mão. Ele é **parcial**, e o
/// predicado vigente, desde a `0011`, é
/// `WHERE "acceptedAt" IS NULL AND "revokedAt" IS NULL`: um e-mail cujo convite
/// foi aceito ou revogado pode ser convidado de novo. Como na `0007`, ele é
/// invisível a este schema, e por isso o comando de diff de migrations do
/// Prisma nunca pode ser rodado aqui: ele apagaria o índice.
model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String    @unique
  invitedById    String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    Person       @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
}

/// Sessão opaca: só o sha256 do token é guardado.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  personId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}
