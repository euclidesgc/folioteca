# Processado pelo envsubst da imagem oficial: só `${API_UPSTREAM}` é trocado.
# As variáveis do nginx ($uri, $host...) ficam intactas porque não existem no
# ambiente do contêiner.

# Atrás do proxy do Coolify o esquema real chega em `X-Forwarded-Proto`; sem
# ele, vale o esquema desta conexão.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;

    # Resolução tardia do upstream: com o nome literal no `proxy_pass`, o nginx
    # resolve na subida e morre ("host not found in upstream") se a API ainda
    # não estiver no ar. Com variável, resolve a cada pedido pelo DNS interno
    # do Docker. Sem parte de caminho no valor, o URI original segue intacto.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Arquivos com hash no nome: podem ficar em cache para sempre.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Mesma origem: a sessão em cookie httpOnly e a checagem de `Origin`
    # contra `Host` no `/collab` funcionam sem CORS.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /collab {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1h;
    }

    # SPA: toda rota que não é arquivo devolve o index.html, sem cache.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
