# Folioteca — variáveis de ambiente.
#
# Copie para `.env` e preencha. O `.env` está no .gitignore desde o primeiro
# commit e nunca entra no repositório. A configuração é validada no boot da API:
# faltando variável obrigatória, o processo não sobe — é de propósito, porque
# subir sem segredo é subir quebrado sem ninguém perceber.
#
# O que cada valor é e onde obtê-lo: docs/setup-secrets.md

# ─── API (apps/api) ────────────────────────────────────────────────────────
# Só a API usa. O Vite também carrega este arquivo e leria o valor como pedido de
# build de desenvolvimento — por isso o `build` de apps/web fixa
# NODE_ENV=production no próprio script.
NODE_ENV=development
PORT=3000

# Postgres com a extensão de vetores. Mesma base para documentos, permissões e
# índice de busca — o filtro de permissão precisa ser condição da mesma consulta.
DATABASE_URL=postgresql://folioteca:senha@localhost:5433/folioteca

# Assinatura do cookie de sessão. Gere um valor aleatório por ambiente, com no
# mínimo 32 caracteres — `openssl rand -hex 32` serve. Trocar este valor
# invalida toda sessão em curso, e sem ele a API não sobe.
BETTER_AUTH_SECRET=

# Endereço público desta API. É a base dos links que saem nos e-mails de
# confirmação de endereço e de recuperação de senha.
API_URL=http://localhost:3000

# Lista de origens do navegador autorizadas a chamar esta API (CORS), separadas
# por vírgula. Cada item é http(s)://host[:porta], sem caminho e sem barra
# final — o formato do cabeçalho Origin que o navegador manda. A web e a API
# vivem em portas distintas, e porta distinta já é origem distinta: sem a
# origem nesta lista a resposta chega, e o navegador a descarta antes de o
# JavaScript vê-la. Obrigatória quando NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173

# Envio de e-mail: confirmação de endereço e recuperação de senha. Em
# desenvolvimento o Mailpit do compose recebe tudo sem credencial, e a caixa
# fica em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Folioteca <nao-responda@folioteca.com>"

# ─── Aplicação web (apps/web) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# Domínio do cookie que guarda a escolha de tema. Vazio em desenvolvimento: sem
# `Domain` o cookie é do host, e cookie não tem porta no escopo — as portas do
# hotsite e da aplicação já o compartilham em localhost. Em homologação e em
# produção recebe o domínio PAI dos dois apps, para a escolha atravessar de um
# subdomínio ao outro. Embutida no build: mudá-la no painel sem reconstruir não
# muda nada.
VITE_COOKIE_DOMAIN=

# ─── Hotsite e documentação (apps/site) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:5173

# O mesmo domínio de VITE_COOKIE_DOMAIN, pelo mesmo motivo: os dois apps
# precisam escrever o cookie de tema no mesmo escopo, ou a escolha não atravessa.
NEXT_PUBLIC_COOKIE_DOMAIN=
