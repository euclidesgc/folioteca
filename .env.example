# Variáveis que o projeto lê. Copie para `.env` e preencha; `.env` nunca é
# versionado. O comentário de cada uma diz onde obter o valor.

# ── react ──
# URL da API do ambiente; o prefixo VITE_ é o que expõe a variável ao bundle
VITE_API_BASE_URL=

# ── nestjs ──
# string de conexão do Postgres; em desenvolvimento, o Testcontainers gera a sua
DATABASE_URL=

# gere com `openssl rand -base64 48`; nunca reaproveite entre ambientes
JWT_SECRET=

# porta do processo; a plataforma de implantação costuma injetar
PORT=

# origens permitidas separadas por vírgula; `*` nunca em produção
CORS_ORIGINS=
